enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}
enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}
model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  type CouponType
  value Int
  minimumSpendAmount Int?
  maximumDiscountAmount Int?
  usageLimit Int?
  usageCount Int @default(0)
  perUserLimit Int?
  startsAt DateTime
  endsAt DateTime
  status PromotionStatus @default(DRAFT)
  restrictions Json?
  usages CouponUsage[]
  redemptions CouponRedemption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model CouponUsage {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  userId String @db.Uuid
  usageCount Int @default(0)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([couponId, userId])
  @@index([userId])
}
model CouponRedemption {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  userId String @db.Uuid
  referenceId String
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([couponId, referenceId])
  @@index([userId, createdAt])
}
model Bundle {
  id String @id @default(uuid()) @db.Uuid
  name String
  bundlePriceAmount Int
  currency String @default("THB") @db.Char(3)
  status PromotionStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  items Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model FlashSale {
  id String @id @default(uuid()) @db.Uuid
  name String
  status PromotionStatus @default(DRAFT)
  startsAt DateTime
  endsAt DateTime
  items Json
  purchases FlashSalePurchase[]
  reservations FlashSaleReservation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model FlashSalePurchase {
  id String @id @default(uuid()) @db.Uuid
  flashSaleId String @db.Uuid
  skuId String @db.Uuid
  userId String @db.Uuid
  quantity Int
  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([flashSaleId, skuId, userId])
}
model FlashSaleReservation {
  id String @id @default(uuid()) @db.Uuid
  flashSaleId String @db.Uuid
  skuId String @db.Uuid
  userId String @db.Uuid
  quantity Int
  referenceId String
  idempotencyKey String @unique
  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([flashSaleId, skuId, userId])
}
