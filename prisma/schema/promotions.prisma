enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}
enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}
model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  type CouponType
  value Int
  minimumSpendAmount Int?
  maximumDiscountAmount Int?
  usageLimit Int?
  usageCount Int @default(0)
  perUserLimit Int?
  startsAt DateTime
  endsAt DateTime
  status PromotionStatus @default(DRAFT)
  restrictions Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model Bundle {
  id String @id @default(uuid()) @db.Uuid
  name String
  bundlePriceAmount Int
  currency String @default("THB") @db.Char(3)
  status PromotionStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  items Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model FlashSale {
  id String @id @default(uuid()) @db.Uuid
  name String
  status PromotionStatus @default(DRAFT)
  startsAt DateTime
  endsAt DateTime
  items Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
