generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}
enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}
enum LedgerType {
  RESTOCK
  RESERVE
  RELEASE
  COMMIT
  ADJUSTMENT
}
enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}
enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
}
enum PaymentMethod {
  PROMPTPAY
  CARD
}
enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  firebaseUid String @unique
  email String? @unique
  displayName String?
  role UserRole @default(CUSTOMER)
  seller Seller?
  cart Cart?
  orders Order[] @relation("CustomerOrders")
  paymentAttempts PaymentAttempt[] @relation("PaymentCustomer")
  auditLogs AuditLog[] @relation("AuditActor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([role])
}
model Seller {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  slug String @unique
  displayName String
  status SellerStatus @default(PENDING)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  products Product[]
  orders Order[] @relation("SellerOrders")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  name String
  slug String
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([parentId, slug])
  @@index([parentId])
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  sellerId String @db.Uuid
  categoryId String? @db.Uuid
  name String
  slug String
  description String?
  media Json?
  status ProductStatus @default(DRAFT)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants Variant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  @@unique([sellerId, slug])
  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
}
model Variant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  name String
  position Int @default(0)
  attributes Json
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  skus SKU[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, name])
  @@index([productId, position])
}
model SKU {
  id String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid
  code String @unique
  barcode String? @unique
  priceAmount Int
  compareAtAmount Int?
  currency String @default("THB") @db.Char(3)
  weightGrams Int?
  isActive Boolean @default(true)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  inventory Inventory?
  ledger InventoryLedger[]
  cartItems CartItem[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([variantId, isActive])
}
model Inventory {
  id String @id @default(uuid()) @db.Uuid
  skuId String @unique @db.Uuid
  availableQuantity Int @default(0)
  reservedQuantity Int @default(0)
  soldQuantity Int @default(0)
  flashSaleAllocation Int @default(0)
  incomingQuantity Int @default(0)
  version Int @default(0)
  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([updatedAt])
}
model InventoryLedger {
  id String @id @default(uuid()) @db.Uuid
  skuId String @db.Uuid
  type LedgerType
  quantityDelta Int
  availableDelta Int @default(0)
  reservedDelta Int @default(0)
  soldDelta Int @default(0)
  referenceType String?
  referenceId String?
  idempotencyKey String? @unique
  metadata Json?
  sku SKU @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([skuId, createdAt])
  @@index([referenceType, referenceId])
}
model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  status CartStatus @default(ACTIVE)
  currency String @default("THB") @db.Char(3)
  version Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}
model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  skuId String @db.Uuid
  quantity Int
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku SKU @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cartId, skuId])
  @@index([skuId])
}
model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  type CouponType
  value Int
  minimumSpendAmount Int?
  maximumDiscountAmount Int?
  usageLimit Int?
  usageCount Int @default(0)
  perUserLimit Int?
  startsAt DateTime
  endsAt DateTime
  status PromotionStatus @default(DRAFT)
  restrictions Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model Bundle {
  id String @id @default(uuid()) @db.Uuid
  name String
  bundlePriceAmount Int
  currency String @default("THB") @db.Char(3)
  status PromotionStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  items Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model FlashSale {
  id String @id @default(uuid()) @db.Uuid
  name String
  status PromotionStatus @default(DRAFT)
  startsAt DateTime
  endsAt DateTime
  items Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt, endsAt])
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  orderNumber String @unique
  customerId String @db.Uuid
  sellerId String @db.Uuid
  status OrderStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  currency String @default("THB") @db.Char(3)
  subtotalAmount Int
  discountAmount Int @default(0)
  shippingAmount Int @default(0)
  totalAmount Int
  promotionSnapshot Json?
  shippingAddress Json
  statusVersion Int @default(0)
  customer User @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  seller Seller @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items OrderItem[]
  paymentAttempts PaymentAttempt[]
  shipments Shipment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt DateTime?
  @@index([customerId, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, paymentStatus, createdAt])
}
model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  skuId String @db.Uuid
  productName String
  variantName String
  skuCode String
  quantity Int
  unitPriceAmount Int
  discountAmount Int @default(0)
  totalAmount Int
  promotionSnapshot Json?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku SKU @relation(fields: [skuId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([skuId])
}
model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  customerId String @db.Uuid
  attemptNumber Int
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Int
  currency String @default("THB") @db.Char(3)
  providerChargeId String? @unique
  providerSourceId String?
  providerEventId String? @unique
  idempotencyKey String? @unique
  providerPayload Json?
  failureCode String?
  expiresAt DateTime?
  version Int @default(0)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer User @relation("PaymentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  @@unique([orderId, attemptNumber])
  @@index([orderId, status])
  @@index([status, createdAt])
}
model Shipment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  status ShipmentStatus @default(PENDING)
  carrier String?
  trackingNumber String? @unique
  trackingUrl String?
  shippedAt DateTime?
  deliveredAt DateTime?
  statusVersion Int @default(0)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, status])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String
  entityType String
  entityId String
  metadata Json?
  ipAddress String?
  userAgent String?
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}
